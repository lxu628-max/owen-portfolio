# ===== Owen Portfolio 环境变量示例 =====
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# 生产环境（Render / 阿里云）通过平台的环境变量面板注入，不要写进仓库。

# [必填] JWT 签名密钥，至少 16 位，用强随机值
# 生成: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-hex-at-least-32-chars

# [必填] 后台管理员初始密码，至少 8 位，用强随机值
# 生成: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password

# [选填] 跨域白名单（生产必填），逗号分隔，例如:
# ALLOWED_ORIGIN=https://aboutowen.cn,https://www.aboutowen.cn
ALLOWED_ORIGIN=

# [选填] Token 有效期，默认 12h
SESSION_EXPIRE=12h

# [选填] 监听端口，默认 3000
PORT=3000

# [选填] 数据库文件路径，默认 db/database.sqlite
# DATABASE_PATH=db/database.sqlite

# [选填] Supabase Storage（图片存对象存储时配置）
# SUPABASE_URL=
# SUPABASE_KEY=
